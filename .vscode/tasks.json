{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Dönüştürücü Arayüzünü Başlat (GUI)",
            "type": "shell",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["app.py"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Klasördeki Tüm STL/3MF Dosyalarını Dönüştür",
            "type": "shell",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["cli.py", "--batch", "input", "--out", "output", "--formats", "step,sldprt,prt"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
